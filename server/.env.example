# Copy this file to server/.env and fill in your own values. Never commit .env.

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/eventboard
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventboard?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/eventboard

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# Development only: where the Vite dev server runs
CLIENT_ORIGIN=http://localhost:5173

# Port for the API server (Render sets this automatically)
PORT=3000
